# Under launchd, brew is on PATH only when the service's plist was written
# from a formula that sets it; one written before has the system's PATH alone,
# until the service is restarted. Every plist sets the working directory to
# Homebrew's prefix, so that is the fallback.
command -v brew >/dev/null || PATH="$(pwd)/bin:$PATH"

# terminal-notifier is Homebrew's own: the version the tap pins, whatever else
# is on PATH.
notifier="$(brew --prefix)/bin/terminal-notifier"

# notify <subtitle> <message>: one notification group, so each one replaces
# the last instead of stacking. mumbrew runs without terminal-notifier, and a
# notification that fails to post never fails the run.
notify(){
  [ -x "$notifier" ] || return 0
  "$notifier" -group mumbrew -title "Mumbrew" -subtitle "$1" -message "$2" >/dev/null || true
}

# Any failing step ends the run (errexit); this says so on screen, where a
# 2AM run is otherwise silent. The detail is in the service's error log.
trap 'notify "Failed" "See farcloser.mumbrew.err.log in Homebrew'"'"'s var/log"' ERR

echo "★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★"
date
echo "Starting mumbrew..."

# stdout only: brew's errors belong in the service's error log.
brew update >/dev/null
outdated=$(brew outdated --quiet | sed -e 's/.*\///')
pinned=$(brew list --pinned)

# brew upgrade skips pinned formulae; the report leaves them out too. A
# whole-line match, because comm would need both lists sorted alike.
outdated=$(grep -vxF -f <(printf '%s\n' "$pinned") <<<"$outdated" || true)

if [ -z "$outdated" ]; then
  echo "Everything up to date"
  notify "Everything up to date" "No updates available"
  exit
fi

notify "Updating" "$(paste -sd ' ' - <<<"$outdated")"

brew upgrade
brew cleanup

notify "Done updating" "$(paste -sd ' ' - <<<"$outdated")"

echo "★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★"
